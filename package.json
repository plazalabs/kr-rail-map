{
  "name": "kr-rail-map",
  "private": true,
  "scripts": {
    "test": "npm run test:data",
    "test:data": "node --test \"tests/data/*.test.mjs\" \"tests/data/regression/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:prod": "cross-env BASE_URL=https://plazalabs.github.io/kr-rail-map/ playwright test",
    "test:all": "npm run test:data && npm run test:e2e",
    "serve": "http-server . -p 4173 -c-1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "cross-env": "^7.0.3",
    "http-server": "^14.1.1"
  }
}
